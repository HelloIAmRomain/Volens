; Engine configuration file.
; Il est normalement préférable d'éditer ces paramètres via l'UI de l'éditeur,
; mais ce fichier est écrit à la main tant que le projet reste headless
; (aucune scène, aucun rendu avant la semaine 4 — voir docs/ARCHITECTURE.md).

config_version=5

[application]

run/main_scene="res://game/ui/app.tscn"

config/name="Volens"
config/version="0.1.0"
config/icon="res://game/ui/icon.png"
config/features=PackedStringArray("4.7", "GL Compatibility")

[editor_plugins]

; GUT (Gut - Godot Unit Test) — dépendance de développement autorisée par
; docs/ARCHITECTURE.md et prévue au DCT §11.2. Exclu des règles de dépendance de core/.
enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[display]

; Résolution de base : 1080×2400 (ratio 9:20), proche des flagships Android
; récents dont l'appareil de référence — largeur 1080 permet un
; redimensionnement entier vers les densités courantes (xhdpi/xxhdpi) sans flou.
window/size/viewport_width=1080
window/size/viewport_height=2400
; Fenêtre de bureau : le portrait 1080×2400 ne tient sur aucun écran
; d'ordinateur. La base de rendu reste 1080×2400 (l'étirement canvas_items
; s'en charge) ; seule la fenêtre est réduite, à ratio identique.
window/size/window_width_override=540
window/size/window_height_override=1200
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; ORIENTATION : UN ENTIER, PAS UNE CHAINE. Elle valait "portrait" — syntaxe
; Godot 3 — que Godot 4 ne comprend pas : la valeur retombait a 0, soit
; PAYSAGE, et le jeu s'affichait couche sur le telephone. Rien ne le disait
; sur le poste de developpement, ou la fenetre est portrait par sa taille.
; 1 = DisplayServer.SCREEN_PORTRAIT. Verifie par tests/arch/test_project_settings.gd.
window/handheld/orientation=1

[internationalization]

; ENF-40/41 — FRANÇAIS ET ANGLAIS LIVRÉS ENSEMBLE, jamais l'un après l'autre.
; Les deux traductions sont produites par l'import de `data/i18n/volens.csv`,
; dont chaque ligne porte les deux langues côte à côte : la parité s'y lit d'un
; coup d'œil, et `tests/unit/test_traductions.gd` la refuse si une case manque.
;
; La locale de démarrage suit celle du système ; le repli est le français.
locale/translations=PackedStringArray("res://data/i18n/volens.en.translation", "res://data/i18n/volens.fr.translation")
locale/fallback="fr"

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
