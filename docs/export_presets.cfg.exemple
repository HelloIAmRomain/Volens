[preset.0]

name="Android"
platform="Android"
runnable=true
advanced_options=true
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter="reports/*, docs/*, tools/*, tests/*, game/selfcheck/*, addons/gut/*, *.lvl, *.md"
